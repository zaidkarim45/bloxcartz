<div id="CartDrawer" class="cart-drawer" data-cart-drawer hidden>
  <div class="cart-drawer__backdrop" data-cart-close></div>
  <div class="cart-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'cart.general.title' | t: default: 'Cart' }}">

    <div class="cart-drawer__header">
      {% render 'icon-cart' %}
      <h2>{{ 'cart.general.title' | t: default: 'Cart' }} <span data-cart-count>{{ cart.item_count }}</span></h2>
      {%- if cart.item_count > 0 -%}
        <button type="button" class="cart-drawer__clear" data-cart-clear>{{ 'cart.general.clear' | t: default: 'Clear cart' }}</button>
      {%- endif -%}
      <button type="button" class="cart-drawer__close" data-cart-close aria-label="Close cart">
        {% render 'icon-close' %}
      </button>
    </div>

    <div class="cart-drawer__items" data-cart-items>
      {%- if cart.item_count == 0 -%}
        <p class="cart-drawer__empty">{{ 'cart.general.empty' | t: default: 'Your cart is empty' }}</p>
      {%- else -%}
        {%- for item in cart.items -%}
          <div class="cart-drawer__line" data-cart-line data-line-key="{{ item.key }}">
            <a href="{{ item.url }}" class="cart-drawer__line-image">
              {{ item.image | image_url: width: 120 | image_tag: alt: item.title, loading: 'lazy' }}
            </a>
            <div class="cart-drawer__line-details">
              <a href="{{ item.url }}" class="cart-drawer__line-title">{{ item.product.title }}</a>
              <div class="price">
                <span class="price__current">{{ item.final_price | money }}</span>
                {%- if item.original_price > item.final_price -%}
                  <span class="price__compare">
                    <span class="price__compare-line"><span></span></span>
                    {{ item.original_price | money }}
                  </span>
                {%- endif -%}
              </div>
              <div class="cart-drawer__qty" data-qty-stepper>
                <button type="button" data-qty-remove aria-label="Remove">&times;</button>
                <span data-qty-value>{{ item.quantity }}</span>
                <button type="button" data-qty-increase aria-label="Increase quantity">+</button>
              </div>
            </div>
            <div class="cart-drawer__line-total">{{ item.final_line_price | money }}</div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if cart.item_count > 0 -%}
      <div class="cart-drawer__footer">
        {%- if settings.cart_show_promo_code -%}
          <form class="cart-drawer__promo" data-promo-form>
            <input type="text" name="discount" placeholder="{{ 'cart.general.promo_code_placeholder' | t: default: 'Enter promo code' }}">
            <button type="submit" class="btn btn--outline">{{ 'cart.general.apply' | t: default: 'Apply' }}</button>
          </form>
        {%- endif -%}
        <div class="cart-drawer__subtotal">
          <span>{{ 'cart.general.subtotal' | t: default: 'Subtotal' }}</span>
          <span data-cart-subtotal>{{ cart.total_price | money }}</span>
        </div>
        <div class="cart-drawer__total">
          <span>{{ 'cart.general.total' | t: default: 'Total' }}</span>
          <span data-cart-total>{{ cart.total_price | money }}</span>
        </div>
        <form action="{{ routes.cart_url }}" method="post">
          <button type="submit" name="checkout" class="btn btn--primary btn--full">
            {{ 'cart.general.checkout' | t: default: 'Checkout' }} {{ cart.total_price | money }}
          </button>
        </form>
      </div>
    {%- endif -%}

  </div>
</div>
