{% comment %}
  Confirmed live on bloxcart.com during Phase 0 (2026-08-28): Crisp chat,
  Termly consent management wired to Google Consent Mode v2, Google Ads/GA4,
  TikTok Pixel, PostHog, Klaviyo. IDs come from Theme settings > Third-party
  scripts so they can be swapped without a code deploy.

  TODO: pull the exact script-category mapping from the Termly dashboard
  (which pixel is "advertising" vs "analytics" vs "essential") so gating
  matches the live site precisely — this scaffold defaults every marketing
  pixel to the same consent gate Phase 0 observed (denied by default,
  granted on accept), which is directionally correct but not yet a byte-for-
  byte match of their Termly config.
{% endcomment %}

<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('consent', 'default', {
    'ad_storage': 'denied',
    'ad_user_data': 'denied',
    'ad_personalization': 'denied',
    'analytics_storage': 'denied',
    'functionality_storage': 'denied',
    'personalization_storage': 'denied',
    'security_storage': 'granted'
  });
</script>

{%- if settings.termly_uuid != blank -%}
  <script src="https://app.termly.io/resource-blocker/{{ settings.termly_uuid }}?autoBlock=off"></script>
{%- endif -%}

{%- if settings.gtag_ads_id != blank or settings.ga4_measurement_id != blank -%}
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ settings.gtag_ads_id | default: settings.ga4_measurement_id }}"></script>
  <script>
    {%- if settings.gtag_ads_id != blank -%}
    gtag('config', '{{ settings.gtag_ads_id }}');
    {%- endif -%}
    {%- if settings.ga4_measurement_id != blank -%}
    gtag('config', '{{ settings.ga4_measurement_id }}');
    {%- endif -%}
  </script>
{%- endif -%}

