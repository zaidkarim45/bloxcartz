{%- if settings.klaviyo_public_key != blank -%}
  <script async type="text/javascript" src="https://static.klaviyo.com/onsite/js/klaviyo.js?company_id={{ settings.klaviyo_public_key }}"></script>
{%- endif -%}

{%- if settings.crisp_website_id != blank -%}
  <script>
    window.$crisp = [];
    window.CRISP_WEBSITE_ID = "{{ settings.crisp_website_id }}";
    (function () {
      var d = document.createElement("script");
      d.src = "https://client.crisp.chat/l.js";
      d.async = 1;
      document.getElementsByTagName("head")[0].appendChild(d);
    })();
  </script>
{%- endif -%}

<script src="{{ 'theme.js' | asset_url }}" defer></script>
