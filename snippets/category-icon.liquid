{%- comment -%}
  Renders a small monochrome-line SVG icon for a category tab/section, plus
  an accent color, for the handful of category names that repeat across
  multiple games' catalogs (best sellers, bundles, guns, knives, seasonal
  specials). Any category slug outside this list — which is expected, since
  each game defines its own category set — falls back to a plain generic
  tag icon rather than guessing.

  Usage: {% render 'category-icon', category: value.value %}
  `category` is the raw category tag value (e.g. "best-sellers", "guns").
{%- endcomment -%}
{%- liquid
  assign key = category | handleize
  assign icon_color = settings.color_accent
-%}
{%- case key -%}
  {%- when 'best-sellers' or 'bestsellers' or 'best-seller' -%}
    {%- assign icon_color = '#FF5470' -%}
    <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14" aria-hidden="true"><path d="M12 2c-.6 2.7-2.8 4.2-4.6 5.9C5.7 9.4 4.5 11.2 4.5 13.5 4.5 18.2 7.9 22 12 22s7.5-3.8 7.5-8.5c0-2.6-1.4-4.6-2.9-6.2-.2 1.6-1 2.7-2 3.3C15 8 14.8 4.6 12 2Z"/></svg>
  {%- when 'bundles' or 'bundle' -%}
    {%- assign icon_color = '#FF5470' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true"><rect x="3" y="8" width="18" height="13" rx="1.5"/><path d="M3 12h18M12 8v13M8 8a2.5 2.5 0 0 1 0-5c1.7 0 3 1.6 4 5 1-3.4 2.3-5 4-5a2.5 2.5 0 0 1 0 5"/></svg>
  {%- when 'guns' or 'gun' -%}
    {%- assign icon_color = 'var(--color-text-secondary)' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true"><path d="M3 13h9l3-3h5v3h-2l-1 4h-4l-1-4H7l-2 4H3z"/></svg>
  {%- when 'knives' or 'knife' -%}
    {%- assign icon_color = 'var(--color-text-secondary)' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true"><path d="M4 20 18 6l2 2L6 22z"/><path d="M14 10l4 4"/></svg>
  {%- when 'summer-specials' or 'summer' or 'seasonal' -%}
    {%- assign icon_color = '#F0A63C' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 3v2M12 19v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M3 12h2M19 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/></svg>
  {%- else -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true"><path d="M20.6 12.6 12.6 20.6a2 2 0 0 1-2.8 0L3 13.8V3h10.8l6.8 6.8a2 2 0 0 1 0 2.8Z"/><circle cx="7.5" cy="7.5" r="1"/></svg>
{%- endcase -%}
