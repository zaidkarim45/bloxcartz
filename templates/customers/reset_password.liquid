<div class="static-page page-width static-page--narrow">
  <h1>{{ 'customer.reset_password.title' | t: default: 'Reset your password' }}</h1>
  {%- form 'reset_customer_password' -%}
    {%- if form.errors -%}
      <div class="alert--warning">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <label><span>{{ 'customer.reset_password.password' | t: default: 'New password' }}</span><input type="password" name="customer[password]" autocomplete="new-password" required></label>
    <label><span>{{ 'customer.reset_password.password_confirm' | t: default: 'Confirm password' }}</span><input type="password" name="customer[password_confirmation]" autocomplete="new-password" required></label>
    <button type="submit" class="btn btn--primary btn--full">{{ 'customer.reset_password.submit' | t: default: 'Reset password' }}</button>
  {%- endform -%}
</div>
