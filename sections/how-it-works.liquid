<section class="how-it-works page-width">
  <h2>{{ section.settings.heading }} <span class="how-it-works__accent">{{ section.settings.heading_accent }}</span></h2>
  <p class="how-it-works__subtext">{{ section.settings.subtext }}</p>

  <div class="how-it-works__steps">
    {%- for block in section.blocks -%}
      {%- if block.type == 'step' -%}
        <div class="how-it-works__step" {{ block.shopify_attributes }}>

          {%- comment -%}
            Illustration per step. Steps 1 and 2 use small mockups built
            from the theme's own real product-card and button styling
            (step 1 pulls two real catalog items rather than invented
            placeholder text); step 3 is an SVG delivery truck since no
            real "delivery truck" asset exists to source honestly --
            flagged here as a deliberate placeholder, not scraped art.
          {%- endcomment -%}
          {%- case forloop.index -%}
            {%- when 1 -%}
              <div class="hiw-illustration hiw-illustration--cards">
                <div class="hiw-mini-card hiw-mini-card--a">
                  <img src="https://cdn.shopify.com/s/files/1/0815/2068/9482/files/Unicorn.webp?v=1781616296" alt="" loading="lazy">
                  <span class="hiw-mini-card__badge">1</span>
                </div>
                <div class="hiw-mini-card hiw-mini-card--b">
                  <img src="https://cdn.shopify.com/s/files/1/0815/2068/9482/files/BlackDragon.webp?v=1783195686" alt="" loading="lazy">
                  <span class="hiw-mini-card__badge">2</span>
                </div>
              </div>
            {%- when 2 -%}
              <div class="hiw-illustration hiw-illustration--cart">
                <button type="button" class="btn btn--primary hiw-cart-btn" tabindex="-1" aria-hidden="true">
                  {% render 'icon-cart' %} {{ 'products.product.add_to_cart' | t: default: 'Add to cart' }}
                </button>
                <svg class="hiw-cursor" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4 2l16 6.5-6.2 2.3L11 17z"/></svg>
              </div>
            {%- when 3 -%}
              <div class="hiw-illustration hiw-illustration--truck">
                <svg viewBox="0 0 200 120" aria-hidden="true">
                  <rect x="8" y="30" width="105" height="55" rx="6" fill="var(--color-accent)"/>
                  <rect x="30" y="46" width="60" height="30" rx="3" fill="#fff" opacity="0.15"/>
                  <text x="60" y="68" text-anchor="middle" font-size="26" font-weight="700" fill="#fff" font-family="var(--font-heading)">b</text>
                  <path d="M113 45h35l25 22v18h-60z" fill="var(--color-accent-button)"/>
                  <rect x="122" y="53" width="24" height="16" rx="2" fill="#fff" opacity="0.25"/>
                  <circle cx="45" cy="88" r="13" fill="#1a1a2e"/>
                  <circle cx="45" cy="88" r="5" fill="#fff" opacity="0.6"/>
                  <circle cx="150" cy="88" r="13" fill="#1a1a2e"/>
                  <circle cx="150" cy="88" r="5" fill="#fff" opacity="0.6"/>
                </svg>
              </div>
          {%- endcase -%}

          <h3>{{ forloop.index }}. {{ block.settings.title }}</h3>
          <p>{{ block.settings.description }}</p>
        </div>
        {%- if forloop.index < section.blocks.size -%}
          <div class="how-it-works__connector" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </div>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How It" },
    { "type": "text", "id": "heading_accent", "label": "Heading, accented word", "default": "Works" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Complete your purchase safely and effortlessly with our protected checkout." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "description", "label": "Description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        { "type": "step", "settings": { "title": "Choose Your Items", "description": "Explore our bestsellers or use the search to quickly find the pets you want." } },
        { "type": "step", "settings": { "title": "Secure Checkout", "description": "Complete your purchase safely and effortlessly with our protected checkout." } },
        { "type": "step", "settings": { "title": "Fast Delivery", "description": "Receive your items instantly through our automated system — ready in just minutes!" } }
      ]
    }
  ]
}
{% endschema %}
