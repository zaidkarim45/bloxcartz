<div class="static-page page-width">
  <p class="static-page__eyebrow">{{ section.settings.eyebrow }}</p>
  <h1>{{ section.settings.heading }}</h1>
  <p class="static-page__intro">{{ section.settings.intro }}</p>

  <div class="faq-list">
    {%- assign current_category = '' -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'question' -%}
        {%- if block.settings.category != current_category -%}
          {%- unless forloop.first -%}</div>{%- endunless -%}
          <h2 class="faq-list__category">{{ block.settings.category }}</h2>
          <div class="faq-list__group">
          {%- assign current_category = block.settings.category -%}
        {%- endif -%}
        <details class="faq-item" {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <div class="faq-item__answer">{{ block.settings.answer }}</div>
        </details>
        {%- if forloop.last -%}</div>{%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- if section.settings.tutorials_url != blank -%}
    <div class="static-page__cta-box">
      <h3>{{ section.settings.tutorials_heading }}</h3>
      <p>{{ section.settings.tutorials_text }}</p>
      <a href="{{ section.settings.tutorials_url }}" class="btn btn--primary">{{ section.settings.tutorials_cta }}</a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "HELP AND FAQS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions." },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Find answers about ordering, delivery, refunds, and account safety. If you still need help, use the support chat." },
    { "type": "header", "content": "Tutorials callout" },
    { "type": "text", "id": "tutorials_heading", "label": "Heading", "default": "Want to watch how it works?" },
    { "type": "textarea", "id": "tutorials_text", "label": "Text", "default": "The tutorials show the order steps and have a video for each supported game." },
    { "type": "text", "id": "tutorials_cta", "label": "Button label", "default": "Open tutorials" },
    { "type": "url", "id": "tutorials_url", "label": "Tutorials link" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "category", "label": "Category" },
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question", "settings": { "category": "Orders and Checkout", "question": "How does ordering work?" } },
        { "type": "question", "settings": { "category": "Orders and Checkout", "question": "Is checkout secure?" } },
        { "type": "question", "settings": { "category": "Orders and Checkout", "question": "Which games do you support?" } },
        { "type": "question", "settings": { "category": "Getting Your Items", "question": "How do I receive my items?" } },
        { "type": "question", "settings": { "category": "Getting Your Items", "question": "How long does delivery take?" } },
        { "type": "question", "settings": { "category": "Getting Your Items", "question": "What should I do if an item is missing?" } },
        { "type": "question", "settings": { "category": "Safety and Refunds", "question": "Will BloxCart ever ask for my Roblox password?" } },
        { "type": "question", "settings": { "category": "Safety and Refunds", "question": "Can I request a refund?" } },
        { "type": "question", "settings": { "category": "Safety and Refunds", "question": "Can I trade an item after receiving it?" } }
      ]
    }
  ]
}
{% endschema %}
