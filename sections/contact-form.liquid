<div class="static-page page-width static-page--narrow">
  <h1>{{ section.settings.heading }}</h1>

  {%- if form.posted_successfully? -%}
    <p class="static-page__success">{{ 'contact.form.post_success' | t: default: "Thanks — we'll be in touch soon." }}</p>
  {%- endif -%}

  {%- form 'contact', class: 'contact-form' -%}
    {%- if form.errors -%}
      <div class="alert--warning">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <label>
      <span>{{ 'contact.form.name' | t: default: 'Name' }}</span>
      <input type="text" name="contact[name]" value="{{ form.name }}">
    </label>
    <label>
      <span>{{ 'contact.form.email' | t: default: 'Email' }}</span>
      <input type="email" name="contact[email]" value="{{ form.email }}" required>
    </label>
    <label>
      <span>{{ 'contact.form.message' | t: default: 'Message' }}</span>
      <textarea name="contact[body]" rows="6" required>{{ form.body }}</textarea>
    </label>
    <button type="submit" class="btn btn--primary btn--full">{{ 'contact.form.send' | t: default: 'Send' }}</button>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact Us" }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
