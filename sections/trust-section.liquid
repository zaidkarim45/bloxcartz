<section class="trust-section page-width">
  <h2>
    {{ section.settings.heading_prefix }}
    <span class="trust-section__accent">{{ section.settings.heading_number }}</span>
    {{ section.settings.heading_suffix }}
  </h2>

  <div class="trust-section__panel">
    <span class="trust-section__dots" aria-hidden="true"></span>
    <div class="trust-section__icon">
      <span class="trust-section__icon-glow" aria-hidden="true"></span>
      <svg viewBox="0 0 64 64" aria-hidden="true" class="trust-section__icon-svg">
        <path d="M12 10h40a6 6 0 0 1 6 6v22a6 6 0 0 1-6 6H30l-11 10v-10h-7a6 6 0 0 1-6-6V16a6 6 0 0 1 6-6z" fill="currentColor"/>
        <circle cx="23" cy="27" r="3.2" fill="var(--color-bg-card)"/>
        <circle cx="32" cy="27" r="3.2" fill="var(--color-bg-card)"/>
        <circle cx="41" cy="27" r="3.2" fill="var(--color-bg-card)"/>
      </svg>
    </div>
    <div class="trust-section__panel-text">
      <h3>{{ section.settings.reviews_note }}</h3>
      <p>{{ section.settings.subtext }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust section",
  "settings": [
    { "type": "text", "id": "heading_prefix", "label": "Heading, before the number", "default": "Trusted By" },
    { "type": "text", "id": "heading_number", "label": "Heading, accented number", "default": "150,000+" },
    { "type": "text", "id": "heading_suffix", "label": "Heading, after the number", "default": "Happy Customers" },
    { "type": "text", "id": "reviews_note", "label": "Reviews note", "default": "New reviews are on the way" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Thousands of orders delivered every week, with support standing by from checkout to delivery." }
  ],
  "presets": [
    { "name": "Trust section" }
  ]
}
{% endschema %}
