<section class="trust-section page-width">
  <h2>{{ section.settings.heading }}</h2>
  <p class="trust-section__reviews-note">{{ section.settings.reviews_note }}</p>
  <p class="trust-section__subtext">{{ section.settings.subtext }}</p>
</section>

{% schema %}
{
  "name": "Trust section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Trusted By 150,000+ Happy Customers" },
    { "type": "text", "id": "reviews_note", "label": "Reviews note", "default": "New reviews are on the way" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Thousands of orders delivered every week, with support standing by from checkout to delivery." }
  ],
  "presets": [
    { "name": "Trust section" }
  ]
}
{% endschema %}
