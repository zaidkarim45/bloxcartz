<section class="hero page-width">
  <div class="hero__content">
    <h1 class="hero__heading">
      {{ section.settings.heading_line_1 }}
      <span class="hero__heading-accent">{{ section.settings.heading_accent }}</span>{{ section.settings.heading_line_2_rest }}
    </h1>
    <p class="hero__subheading">{{ section.settings.subheading }}</p>

    {%- if section.blocks.size > 0 -%}
      <div class="hero__trust-badges">
        {%- for block in section.blocks -%}
          {%- if block.type == 'trust_badge' -%}
            <div class="hero__trust-badge" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}
                <span class="hero__trust-badge-icon">{{ block.settings.icon }}</span>
              {%- endif -%}
              <span>
                <strong>{{ block.settings.label }}</strong>
                <small>{{ block.settings.sublabel }}</small>
              </span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.cta_url != blank -%}
      <a href="{{ section.settings.cta_url }}" class="btn btn--hero">{{ section.settings.cta_label }}</a>
    {%- endif -%}
  </div>

  <div class="hero__illustration">
    {%- if section.settings.illustration != blank -%}
      {{ section.settings.illustration | image_url: width: 1200 | image_tag: alt: '', loading: 'eager', fetchpriority: 'high' }}
    {%- else -%}
      {%- comment -%}
        Fallback composition until a merchant uploads a custom illustration:
        two real catalog items (not stock/AI art) floating on glow
        platforms, matching the reference site's hero layout.
      {%- endcomment -%}
      <div class="hero__floater hero__floater--a">
        <img src="https://cdn.shopify.com/s/files/1/0815/2068/9482/files/40.1.png?v=1715367785" alt="" loading="eager" fetchpriority="high">
        <span class="hero__floater-glow"></span>
      </div>
      <div class="hero__floater hero__floater--b">
        <img src="https://cdn.shopify.com/s/files/1/0815/2068/9482/files/latest_dcf10cb9-6853-42c7-a93b-ae82f8bb121c.png?v=1761689961" alt="" loading="eager">
        <span class="hero__floater-glow hero__floater-glow--blue"></span>
      </div>
      <span class="hero__sparkle" style="top: 8%; left: 5%;"></span>
      <span class="hero__sparkle" style="top: 20%; right: 8%;"></span>
      <span class="hero__sparkle" style="bottom: 30%; left: 2%;"></span>
      <span class="hero__sparkle" style="bottom: 10%; right: 15%;"></span>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading, line 1",
      "default": "Get your favourite"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading, accented phrase",
      "default": "in-game"
    },
    {
      "type": "text",
      "id": "heading_line_2_rest",
      "label": "Heading, rest of line 2",
      "default": " items"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Buy game items, pets & more instantly with fast delivery and 100% secure checkout"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Explore games"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA link"
    },
    {
      "type": "image_picker",
      "id": "illustration",
      "label": "Decorative illustration"
    }
  ],
  "blocks": [
    {
      "type": "trust_badge",
      "name": "Trust badge",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji or short text)" },
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "sublabel", "label": "Sublabel" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "trust_badge", "settings": { "icon": "✓", "label": "100%", "sublabel": "Secure" } },
        { "type": "trust_badge", "settings": { "icon": "⚡", "label": "Instant", "sublabel": "Delivery" } },
        { "type": "trust_badge", "settings": { "icon": "24", "label": "24/7", "sublabel": "Support" } }
      ]
    }
  ]
}
{% endschema %}
