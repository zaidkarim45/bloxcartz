{%- comment -%}
  Restored 2026-08-29 after confirming this exact content was previously
  validated by Shopify (matches commit 44fd1f1 byte-for-byte).
  Auto-resolves the 9 games against real Shopify collections (matched by
  handle == game slug) rather than requiring a merchant to manually pick a
  collection per block. Once a collection has its own image uploaded in
  Admin, that takes over from the hotlinked fallback icon automatically
  (coll.image wins over the hardcoded icon URL below).

  Deliberately plain `case`/`assign` here instead of building a JSON
  registry + `parse_json` — that pattern silently failed on live Shopify
  (the whole section dropped with no visible error), so this sticks to
  well-established Liquid the storefront is guaranteed to execute. The
  same slug list is duplicated in sections/header.liquid for its game
  dropdown — keep both in sync if a game is added/removed/renamed.
{%- endcomment -%}

<section class="game-grid-section page-width">
  <div class="game-grid-section__header">
    <h2>{{ section.settings.heading }}</h2>
    <form role="search" action="{{ routes.search_url }}" class="game-grid-section__search">
      <input type="search" name="q" placeholder="{{ 'general.search.placeholder' | t: default: 'Search game' }}">
    </form>
    {%- if section.settings.view_all_url != blank -%}
      <a href="{{ section.settings.view_all_url }}" class="game-grid-section__view-all">{{ section.settings.view_all_label }}</a>
    {%- endif -%}
  </div>

  <div class="game-grid">
    {%- assign game_slugs = 'murder-mystery-2,steal-a-brainrot,blox-fruits,adopt-me,pet-simulator-99,blade-ball,grow-a-garden-2,99-nights-in-the-forest,dress-to-impress' | split: ',' -%}
    {%- for slug in game_slugs -%}
      {%- liquid
        case slug
          when 'murder-mystery-2'
            assign game_title = 'Murder Mystery 2'
            assign gradient_start = '#B91C1C'
            assign gradient_end = '#450A0A'
            assign icon = 'https://media.bloxcart.com/payload-media/murder-mystery-2-thumbnail.webp'
            assign external_url = ''
          when 'steal-a-brainrot'
            assign game_title = 'Steal a Brainrot'
            assign gradient_start = '#7C3AED'
            assign gradient_end = '#2E1065'
            assign icon = 'https://media.bloxcart.com/payload-media/steal-a-brainrot-thumbnail.webp'
            assign external_url = ''
          when 'blox-fruits'
            assign game_title = 'Blox Fruits'
            assign gradient_start = '#EA580C'
            assign gradient_end = '#431407'
            assign icon = 'https://media.bloxcart.com/payload-media/blox-fruits-thumbnail.webp'
            assign external_url = ''
          when 'adopt-me'
            assign game_title = 'Adopt Me'
            assign gradient_start = '#DB2777'
            assign gradient_end = '#500724'
            assign icon = 'https://media.bloxcart.com/payload-media/adopt-me-thumbnail.png'
            assign external_url = 'https://neonpets.com/discount/CART?utm_source=bloxcart&utm_medium=referral'
          when 'pet-simulator-99'
            assign game_title = 'Pet Simulator 99'
            assign gradient_start = '#0D9488'
            assign gradient_end = '#042F2E'
            assign icon = 'https://media.bloxcart.com/payload-media/pet-simulator-99-thumbnail-1.webp'
            assign external_url = ''
          when 'blade-ball'
            assign game_title = 'Blade Ball'
            assign gradient_start = '#334155'
            assign gradient_end = '#0F172A'
            assign icon = 'https://media.bloxcart.com/payload-media/blade-ball-thumbnail.png'
            assign external_url = ''
          when 'grow-a-garden-2'
            assign game_title = 'Grow a Garden 2'
            assign gradient_start = '#16A34A'
            assign gradient_end = '#052E16'
            assign icon = 'https://media.bloxcart.com/payload-media/grow-a-garden-2-thumbnail.webp'
            assign external_url = ''
          when '99-nights-in-the-forest'
            assign game_title = '99 Nights in the Forest'
            assign gradient_start = '#166534'
            assign gradient_end = '#052E16'
            assign icon = 'https://media.bloxcart.com/payload-media/99-nights-in-the-forest-thumbnail.png'
            assign external_url = ''
          when 'dress-to-impress'
            assign game_title = 'Dress to Impress'
            assign gradient_start = '#BE185D'
            assign gradient_end = '#500724'
            assign icon = 'https://media.bloxcart.com/payload-media/dress-to-impress-thumbnail.webp'
            assign external_url = ''
        endcase

        assign coll = collections[slug]
        assign is_external = false
        if external_url != blank
          assign is_external = true
        endif

        assign game_url = '#'
        if is_external
          assign game_url = external_url
        endif
        if coll.url != blank
          assign game_url = coll.url
        endif

        assign game_image = icon
        if coll.image != blank
          assign game_image = coll.image
        endif

        if coll.title != blank
          assign game_title = coll.title
        endif
      -%}
      {% render 'game-card',
        game_title: game_title,
        game_url: game_url,
        game_image: game_image,
        gradient_start: gradient_start,
        gradient_end: gradient_end,
        limited_stock: false,
        external: is_external
      %}
    {%- endfor -%}

    {%- comment -%} Merchant-added extra cards beyond the standard 9, if any {%- endcomment -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'game' -%}
        {%- liquid
          assign game_title = block.settings.title
          assign game_url = '#'
          if block.settings.external_url != blank
            assign game_url = block.settings.external_url
          endif
          if block.settings.collection.url != blank
            assign game_url = block.settings.collection.url
          endif
          assign game_image = block.settings.image | default: block.settings.collection.featured_image
          assign external = false
          if block.settings.external_url != blank
            assign external = true
          endif
        -%}
        <div {{ block.shopify_attributes }}>
          {%- render 'game-card',
            game_title: game_title,
            game_url: game_url,
            game_image: game_image,
            gradient_start: block.settings.gradient_start,
            gradient_end: block.settings.gradient_end,
            limited_stock: block.settings.limited_stock,
            external: external
          -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Game grid v2",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "All games"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "Explore games"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "View all link"
    }
  ],
  "blocks": [
    {
      "type": "game",
      "name": "Extra game",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "url",
          "id": "external_url",
          "label": "External URL (overrides collection link)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image (overrides collection image)"
        },
        {
          "type": "color",
          "id": "gradient_start",
          "label": "Gradient start",
          "default": "#8B5CF6"
        },
        {
          "type": "color",
          "id": "gradient_end",
          "label": "Gradient end",
          "default": "#4C1D95"
        },
        {
          "type": "checkbox",
          "id": "limited_stock",
          "label": "Show \"Limited Stock\" badge",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Game grid"
    }
  ]
}
{% endschema %}
