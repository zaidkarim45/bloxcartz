<div class="static-page page-width static-page--narrow static-page--center">
  <h1>{{ section.settings.heading }}</h1>
  <p class="static-page__intro">{{ section.settings.text }}</p>
  <a href="/" class="btn btn--primary">{{ section.settings.cta_label }}</a>
</div>

{% schema %}
{
  "name": "404",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Page not found" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "The page you're looking for doesn't exist or may have moved." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Back to home" }
  ]
}
{% endschema %}
