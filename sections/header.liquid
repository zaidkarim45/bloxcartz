<header class="site-header">
  <div class="page-width site-header__inner">

    <a href="{{ routes.root_url }}" class="site-header__logo" aria-label="{{ shop.name }} home">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 200 | image_tag: alt: shop.name, class: 'site-header__logo-img' }}
      {%- else -%}
        {%- comment -%} Fallback to bloxcart.com's own logo asset (confirmed public at /assets/logo.webp) until a merchant uploads one via Theme settings -> Logo. Icon+wordmark are baked into that one image, so no separate text label. {%- endcomment -%}
        <img src="https://bloxcart.com/assets/logo.webp" alt="{{ shop.name }}" class="site-header__logo-img">
      {%- endif -%}
    </a>

    {%- comment -%}
      Same slug/gradient/icon list as sections/game-grid.liquid, kept
      inline rather than shared via a data snippet — see that file's
      header comment for why (parse_json + capture silently dropped the
      whole section on live Shopify). Keep both lists in sync.
    {%- endcomment -%}
    {%- liquid
      # Same fallback icon used per-slug in the list below -- computed here
      # too so the trigger button shows a real icon tile even when the
      # current collection has no image of its own uploaded yet (matches
      # the always-a-box treatment every list row already gets).
      assign current_game_icon = ''
      case collection.handle
        when 'murder-mystery-2'
          assign current_game_icon = 'https://media.bloxcart.com/payload-media/murder-mystery-2-icon.webp'
        when 'steal-a-brainrot'
          assign current_game_icon = 'https://media.bloxcart.com/payload-media/steal-a-brainrot-icon.webp'
        when 'blox-fruits'
          assign current_game_icon = 'https://media.bloxcart.com/payload-media/blox-fruits-icon.webp'
        when 'adopt-me'
          assign current_game_icon = 'https://media.bloxcart.com/payload-media/adopt-me-icon-1.webp'
        when 'pet-simulator-99'
          assign current_game_icon = 'https://media.bloxcart.com/payload-media/pet-simulator-99-icon-1.webp'
        when 'blade-ball'
          assign current_game_icon = 'https://media.bloxcart.com/payload-media/blade-ball-icon.webp'
        when 'grow-a-garden-2'
          assign current_game_icon = 'https://media.bloxcart.com/payload-media/grow-a-garden-2-icon.webp'
        when '99-nights-in-the-forest'
          assign current_game_icon = 'https://media.bloxcart.com/payload-media/99-nights-in-the-forest-icon.webp'
        when 'dress-to-impress'
          assign current_game_icon = 'https://media.bloxcart.com/payload-media/dress-to-impress-icon.webp'
      endcase
      if collection.image != blank
        assign current_game_icon = collection.image | image_url: width: 40
      endif
    -%}
    <div class="site-header__game-select" data-game-select>
      <button type="button" class="site-header__game-select-btn" aria-haspopup="listbox" aria-expanded="false">
        {%- if collection and collection.handle != blank -%}
          <span class="site-header__game-icon-tile">
            {%- if current_game_icon != blank -%}
              <img src="{{ current_game_icon }}" alt="" class="site-header__game-icon" loading="eager">
            {%- endif -%}
          </span>
          <span class="site-header__game-select-label">{{ collection.title }}</span>
        {%- else -%}
          <span class="site-header__game-select-placeholder">?</span>
          <span class="site-header__game-select-label">Select game</span>
        {%- endif -%}
        {% render 'icon-chevron-down' %}
      </button>
      <div class="site-header__game-backdrop" data-game-select-close></div>
      <div class="site-header__game-menu" hidden>
        <div class="site-header__game-menu-header">
          <span>{{ 'general.header.game_select_title' | t: default: 'Select game' }}</span>
          <button type="button" class="site-header__game-menu-close" data-game-select-close aria-label="{{ 'general.accessibility.close' | t: default: 'Close' }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </button>
        </div>
        <div class="site-header__game-search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          <input type="search" placeholder="Search games" data-game-search aria-label="Search games">
        </div>
        <ul class="site-header__game-list" role="listbox">
        {%- assign game_slugs = 'murder-mystery-2,steal-a-brainrot,blox-fruits,adopt-me,pet-simulator-99,blade-ball,grow-a-garden-2,99-nights-in-the-forest,dress-to-impress' | split: ',' -%}
        {%- for slug in game_slugs -%}
          {%- liquid
            case slug
              when 'murder-mystery-2'
                assign game_title = 'Murder Mystery 2'
                assign icon = 'https://media.bloxcart.com/payload-media/murder-mystery-2-icon.webp'
                assign external_url = ''
              when 'steal-a-brainrot'
                assign game_title = 'Steal a Brainrot'
                assign icon = 'https://media.bloxcart.com/payload-media/steal-a-brainrot-icon.webp'
                assign external_url = ''
              when 'blox-fruits'
                assign game_title = 'Blox Fruits'
                assign icon = 'https://media.bloxcart.com/payload-media/blox-fruits-icon.webp'
                assign external_url = ''
              when 'adopt-me'
                assign game_title = 'Adopt Me'
                assign icon = 'https://media.bloxcart.com/payload-media/adopt-me-icon-1.webp'
                assign external_url = ''
              when 'pet-simulator-99'
                assign game_title = 'Pet Simulator 99'
                assign icon = 'https://media.bloxcart.com/payload-media/pet-simulator-99-icon-1.webp'
                assign external_url = ''
              when 'blade-ball'
                assign game_title = 'Blade Ball'
                assign icon = 'https://media.bloxcart.com/payload-media/blade-ball-icon.webp'
                assign external_url = ''
              when 'grow-a-garden-2'
                assign game_title = 'Grow a Garden 2'
                assign icon = 'https://media.bloxcart.com/payload-media/grow-a-garden-2-icon.webp'
                assign external_url = ''
              when '99-nights-in-the-forest'
                assign game_title = '99 Nights in the Forest'
                assign icon = 'https://media.bloxcart.com/payload-media/99-nights-in-the-forest-icon.webp'
                assign external_url = ''
              when 'dress-to-impress'
                assign game_title = 'Dress to Impress'
                assign icon = 'https://media.bloxcart.com/payload-media/dress-to-impress-icon.webp'
                assign external_url = ''
            endcase

            assign coll = collections[slug]
            assign is_external = false
            if external_url != blank
              assign is_external = true
            endif

            assign game_url = '#'
            if is_external
              assign game_url = external_url
            endif
            if coll.url != blank
              assign game_url = coll.url
            endif

            assign game_image = icon
            if coll.image != blank
              assign game_image = coll.image
            endif

            if coll.title != blank
              assign game_title = coll.title
            endif

            # Not using image_url/image_tag filters here (see
            # snippets/game-card.liquid) -- they throw a hard "invalid
            # url input" error on anything not a recognized Shopify file
            # reference, which was silently killing this whole section.
            assign img_src = game_image
            if game_image.src != blank
              assign img_src = game_image.src
            endif

            assign is_current_game = false
            if collection.handle == slug
              assign is_current_game = true
            endif
          -%}
          <li role="option" aria-selected="{{ is_current_game }}" data-game-name="{{ game_title | downcase }}" class="{% if is_current_game %}is-active{% endif %}">
            <a href="{{ game_url }}" {% if is_external %}target="_blank" rel="noopener sponsored"{% endif %}>
              {%- if img_src != blank -%}
                <img src="{{ img_src }}" alt="{{ game_title }}" loading="lazy">
              {%- endif -%}
              <span>{{ game_title }}</span>
              {% render 'icon-chevron-down' %}
            </a>
          </li>
        {%- endfor -%}
        </ul>
        <p class="site-header__game-empty" hidden>No games found.</p>
      </div>
    </div>

    <div class="site-header__actions">
      {%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
        <button type="button" class="site-header__locale" aria-haspopup="dialog" aria-expanded="false" aria-controls="LocaleModal" data-locale-toggle>
          <span class="site-header__locale-flag" aria-hidden="true">{% render 'country-flag', iso_code: localization.country.iso_code %}</span>
          <span>{{ localization.language.endonym_name | capitalize }}</span>
          <span aria-hidden="true">/</span>
          <span>{{ cart.currency.iso_code }}</span>
        </button>

        <div class="locale-modal__backdrop" data-locale-close></div>
        <div class="locale-modal" id="LocaleModal" role="dialog" aria-modal="true" aria-labelledby="LocaleModalTitle" hidden>
          <div class="locale-modal__header">
            <h2 id="LocaleModalTitle">{{ 'general.localization.title' | t: default: 'Language & Currency' }}</h2>
            <button type="button" class="locale-modal__close" data-locale-close aria-label="{{ 'general.accessibility.close' | t: default: 'Close' }}">
              {% render 'icon-close' %}
            </button>
          </div>

          {%- if localization.available_languages.size > 1 -%}
            <div class="locale-modal__field">
              <label for="LocaleModalLanguage">{{ 'general.localization.language_label' | t: default: 'Language' }}</label>
              {%- form 'localization', id: 'LocaleModalLanguageForm' -%}
                <div class="locale-modal__select-wrap">
                  <span class="locale-modal__select-flag" aria-hidden="true">{% render 'country-flag', iso_code: localization.country.iso_code %}</span>
                  <select name="locale_code" id="LocaleModalLanguage" data-locale-autosubmit>
                    {%- for language in localization.available_languages -%}
                      <option value="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>
                        {{ language.endonym_name | capitalize }}
                      </option>
                    {%- endfor -%}
                  </select>
                  {% render 'icon-chevron-down' %}
                </div>
              {%- endform -%}
            </div>
          {%- endif -%}

          {%- if localization.available_countries.size > 1 -%}
            <div class="locale-modal__field">
              <label for="LocaleModalCurrency">{{ 'general.localization.currency_label' | t: default: 'Currency' }}</label>
              {%- form 'localization', id: 'LocaleModalCurrencyForm' -%}
                <div class="locale-modal__select-wrap">
                  <span class="locale-modal__select-badge">{{ localization.country.currency.iso_code }}</span>
                  <select name="country_code" id="LocaleModalCurrency" data-locale-autosubmit>
                    {%- for country in localization.available_countries -%}
                      <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>
                        {{ country.currency.iso_code }} &middot; {{ country.currency.name }}
                      </option>
                    {%- endfor -%}
                  </select>
                  {% render 'icon-chevron-down' %}
                </div>
              {%- endform -%}
            </div>
          {%- endif -%}

          <p class="locale-modal__note">{{ 'general.localization.note' | t: default: 'Prices update to reflect the selected currency. You will be charged in that currency at checkout.' }}</p>
        </div>
      {%- endif -%}

      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_login_url }}" class="btn btn--primary site-header__login">
          <svg class="site-header__login-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path><polyline points="10 17 15 12 10 7"></polyline><line x1="15" y1="12" x2="3" y2="12"></line></svg>
          {{ 'customer.login_page.title' | t }}
        </a>
        <span class="site-header__divider" aria-hidden="true"></span>
      {%- endif -%}

      <button type="button" class="site-header__cart" data-cart-toggle aria-haspopup="dialog" aria-controls="CartDrawer">
        <span class="site-header__cart-shine" aria-hidden="true"></span>
        <span class="site-header__cart-icon">{% render 'icon-cart' %}</span>
        <span class="site-header__cart-label">
          <span class="site-header__cart-sublabel">{{ 'cart.general.for_checkout' | t: default: 'For checkout' }}</span>
          <span data-cart-total>{{ cart.total_price | money }}</span>
        </span>
        {% render 'icon-chevron-down' %}
        <span class="site-header__cart-count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      </button>

      <button type="button" class="site-header__menu-toggle" data-mobile-menu-toggle aria-label="Open menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>

  </div>

  {%- comment -%}
    Mobile-only floating cart pill (hidden on desktop, replaces the inline
    header cart pill below ~480px -- see the mobile media query in
    layout.css). Deliberately still inside .site-header, not a separate
    fixed-positioned element elsewhere in the page, so the existing
    `.site-header [data-cart-count]` / `[data-cart-total]` sync logic in
    theme.js picks it up for free with zero JS changes -- position:fixed
    on this button still anchors to the viewport regardless of .site-header
    being sticky, since nothing in that ancestor chain sets a transform/
    filter that would change its containing block.
  {%- endcomment -%}
  <button
    type="button"
    class="site-header__cart site-header__cart--floating"
    data-cart-toggle
    aria-haspopup="dialog"
    aria-controls="CartDrawer"
  >
    <span class="site-header__cart-icon">{% render 'icon-cart' %}</span>
    <span data-cart-total>{{ cart.total_price | money }}</span>
    <span class="site-header__cart-count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
  </button>
</header>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
