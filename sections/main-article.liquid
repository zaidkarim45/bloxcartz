<article class="static-page page-width static-page--narrow">
  <p class="static-page__eyebrow">{{ article.published_at | date: '%B %d, %Y' }}</p>
  <h1>{{ article.title }}</h1>
  {%- if article.image -%}
    {{ article.image | image_url: width: 900 | image_tag: alt: article.title, loading: 'eager' }}
  {%- endif -%}
  <div class="static-page__rich-text rte">{{ article.content }}</div>
</article>

{% schema %}
{
  "name": "Article",
  "settings": []
}
{% endschema %}
