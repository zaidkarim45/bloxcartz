{%- comment -%}
  Filtering/faceting is powered by Shopify's native Search & Discovery app via
  `collection.filters` — install it and configure filters for this collection
  (price, availability, and a tag-based filter for "category" and "rarity")
  before this section will show real counts. Until then the pill tab bar and
  rarity checkboxes render from collection.all_tags without counts as a
  fallback (see the `category_filter` / `rarity_filter` lookups below).

  Tab bar → category is modeled as a `category:{slug}` tag per product
  (see PHASE_0_EXTRACTION_NOTES.md — tab sets differ per game, e.g. MM2 has
  Guns/Knives/Summer Specials, Steal a Brainrot has Brainrots/Gamepasses/Money).
  Rarity is modeled as a `rarity:{value}` tag per product — vocabulary is
  per-game and NOT a fixed enum (see notes), so this stays free-text rather
  than a structured option/metafield.
{%- endcomment -%}

{%- liquid
  assign category_filter = null
  assign rarity_filter = null
  assign price_filter = null
  assign availability_filter = null
  for filter in collection.filters
    if filter.param_name contains 'category'
      assign category_filter = filter
    elsif filter.param_name contains 'rarity'
      assign rarity_filter = filter
    elsif filter.type == 'price_range'
      assign price_filter = filter
    elsif filter.param_name contains 'available'
      assign availability_filter = filter
    endif
  endfor

  # Fallback facets, used whenever collection.filters doesn't provide a
  # given facet (see file header). Both are modeled as plain product tags
  # already, so this reads real catalog data rather than inventing
  # anything -- see snippets/category-icon.liquid + rarity-color.
  assign category_tags = ''
  assign rarity_tags = ''
  for tag in collection.all_tags
    if tag contains 'category:'
      assign category_tags = category_tags | append: tag | append: '||'
    endif
    if tag contains 'rarity:'
      assign rarity_tags = rarity_tags | append: tag | append: '||'
    endif
  endfor
  assign category_tags = category_tags | split: '||'
  assign rarity_tags = rarity_tags | split: '||'

  assign category_counts = ''
  assign rarity_counts = ''
  assign in_stock_count = 0

  # `collection` (and therefore `collection.products`) reflects whatever
  # filters/tags are ALREADY active on the current URL -- counting against
  # it means every count shrinks or zeroes out the moment ANY filter is
  # applied, which is the bug: selecting one category made every rarity
  # count read 0, because collection.products had already been narrowed
  # to just that category's products. `collections[collection.handle]` is
  # a fresh, independent lookup of the same collection that is NOT scoped
  # by the current request's filters, so it's the correct base set for
  # counts that should stay constant (matching the whole game's catalog)
  # regardless of what's currently selected.
  assign base_collection = collections[collection.handle]
-%}
{%- comment -%}
  Counts deliberately use a plain nested for/if loop instead of any
  single-shot array filter (`where`/`where_exp`) -- that's the only
  mechanism with zero dependency on filter-specific semantics (array
  containment support, expression-string variable scoping, etc.) that
  turned out to behave inconsistently on the live store. A for/if loop
  over `product.tags contains tag` is basic Liquid control flow with
  nothing left to go wrong. Always computed (not just when the native
  filter is missing) so the displayed number next to a native checkbox
  can be overridden with this stable, always-whole-catalog count too.
{%- endcomment -%}
{%- paginate base_collection.products by 250 -%}
  {%- liquid
    assign in_stock_count = 0
    for p in base_collection.products
      if p.available
        assign in_stock_count = in_stock_count | plus: 1
      endif
    endfor

    assign category_counts = ''
    for tag in category_tags
      assign tag_count = 0
      for p in base_collection.products
        if p.tags contains tag
          assign tag_count = tag_count | plus: 1
        endif
      endfor
      assign category_counts = category_counts | append: tag_count | append: '||'
    endfor
    assign category_counts = category_counts | split: '||'

    assign rarity_counts = ''
    for tag in rarity_tags
      assign tag_count = 0
      for p in base_collection.products
        if p.tags contains tag
          assign tag_count = tag_count | plus: 1
        endif
      endfor
      assign rarity_counts = rarity_counts | append: tag_count | append: '||'
    endfor
    assign rarity_counts = rarity_counts | split: '||'
  -%}
{%- endpaginate -%}

<div class="collection-page">
  <h1 class="visually-hidden">{{ collection.title }}</h1>

  <button type="button" class="collection-filters__toggle" data-filter-toggle aria-expanded="false" aria-controls="CollectionFilters">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true"><line x1="4" y1="6" x2="20" y2="6"></line><line x1="7" y1="12" x2="17" y2="12"></line><line x1="10" y1="18" x2="14" y2="18"></line></svg>
    {{ 'collections.filters.title' | t: default: 'Filter' }}
  </button>

  <div class="collection-page__layout">

    <aside class="collection-filters" id="CollectionFilters" data-collection-filters>
      <form method="get" action="{{ collection.url }}" data-filter-form>
      <div class="collection-filters__header">
        <span>{{ 'collections.filters.title' | t: default: 'Filter' }}</span>
        <span class="badge">{{ collection.products_count }} {{ 'collections.filters.items' | t: default: 'items' }}</span>
        <a href="{{ collection.url }}" class="collection-filters__reset">{{ 'collections.filters.reset_all' | t: default: 'Reset all' }}</a>
      </div>

      {%- if price_filter -%}
        <div class="collection-filters__group">
          <h3>{{ 'collections.filters.price' | t: default: 'Price' }}</h3>
          <div class="collection-filters__price-inputs">
            <label>
              <span>{{ 'collections.filters.from' | t: default: 'From' }}</span>
              <input type="text" inputmode="decimal" name="{{ price_filter.min_value.param_name }}" value="{{ price_filter.min_value.value }}" placeholder="{{ price_filter.range_min | money }}" data-price-from data-raw="{{ price_filter.min_value.value | default: price_filter.range_min }}">
            </label>
            <label>
              <span>{{ 'collections.filters.to' | t: default: 'To' }}</span>
              <input type="text" inputmode="decimal" name="{{ price_filter.max_value.param_name }}" value="{{ price_filter.max_value.value }}" placeholder="{{ price_filter.range_max | money }}" data-price-to data-raw="{{ price_filter.max_value.value | default: price_filter.range_max }}">
            </label>
          </div>
          <div class="collection-filters__slider" data-price-slider data-min="{{ price_filter.range_min }}" data-max="{{ price_filter.range_max }}">
            <div class="collection-filters__slider-track"></div>
            <div class="collection-filters__slider-range" data-price-range></div>
            <input type="range" min="{{ price_filter.range_min }}" max="{{ price_filter.range_max }}" value="{{ price_filter.min_value.value | default: price_filter.range_min }}" data-price-range-from>
            <input type="range" min="{{ price_filter.range_min }}" max="{{ price_filter.range_max }}" value="{{ price_filter.max_value.value | default: price_filter.range_max }}" data-price-range-to>
          </div>
        </div>
      {%- endif -%}

      {%- if availability_filter -%}
        <div class="collection-filters__group">
          <h3>{{ 'collections.filters.availability' | t: default: 'Availability' }}</h3>
          {%- for value in availability_filter.values -%}
            <label class="collection-filters__checkbox">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 7 9 18l-5-5"></path></svg>
              <span>{{ 'collections.filters.in_stock_only' | t: default: 'In stock only' }}</span>
              <span class="collection-filters__count">({{ in_stock_count }})</span>
              <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}>
            </label>
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="collection-filters__group">
          <h3>{{ 'collections.filters.availability' | t: default: 'Availability' }}</h3>
          <label class="collection-filters__checkbox">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 7 9 18l-5-5"></path></svg>
            <span>{{ 'collections.filters.in_stock_only' | t: default: 'In stock only' }}</span>
            <span class="collection-filters__count">({{ in_stock_count }})</span>
            <input type="checkbox" data-instock-toggle>
          </label>
        </div>
      {%- endif -%}

      {%- if rarity_filter -%}
        <div class="collection-filters__group">
          <h3>{{ 'collections.filters.rarity' | t: default: 'Rarity' }}</h3>
          {%- for value in rarity_filter.values -%}
            {%- liquid
              assign static_count = value.count
              for t in rarity_tags
                assign t_stripped = t | remove_first: 'rarity:'
                if t == value.value or t_stripped == value.value
                  assign static_count = rarity_counts[forloop.index0]
                endif
              endfor
            -%}
            <label class="collection-filters__checkbox" for="rarity-{{ value.value | handleize }}" id="rarity-{{ value.value | handleize }}-label">
              <input type="checkbox" id="rarity-{{ value.value | handleize }}" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}>
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="{% render 'rarity-color', rarity: value.label %}" class="shrink-0 size-5"><path d="M18.5 3.7l2.9 3.3c.7.8.7 1.9.1 2.7L13.7 20.2c-.9 1.1-2.6 1.1-3.4 0L2.4 9.8c-.6-.8-.6-2 .1-2.7l2.9-3.3C5.9 3.3 6.5 3 7 3h10c.6 0 1.1.3 1.5.7z"/></svg>
              <span>{{ value.label | capitalize }}</span>
              <span class="collection-filters__count">({{ static_count }})</span>
            </label>
          {%- endfor -%}
        </div>
      {%- elsif rarity_tags.size > 0 -%}
        <div class="collection-filters__group">
          <h3>{{ 'collections.filters.rarity' | t: default: 'Rarity' }}</h3>
          {%- for tag in rarity_tags -%}
            {%- unless tag == blank -%}
              {%- liquid
                assign rarity_value = tag | remove_first: 'rarity:'
                assign rarity_active = false
                if current_tags contains tag
                  assign rarity_active = true
                endif
                assign tag_handle = tag | handleize
                assign tag_url = collection.url | append: '/' | append: tag_handle
              -%}
              <a href="{{ tag_url }}" class="collection-filters__checkbox {% if rarity_active %}is-active{% endif %}">
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="{% render 'rarity-color', rarity: rarity_value %}" class="shrink-0 size-5"><path d="M18.5 3.7l2.9 3.3c.7.8.7 1.9.1 2.7L13.7 20.2c-.9 1.1-2.6 1.1-3.4 0L2.4 9.8c-.6-.8-.6-2 .1-2.7l2.9-3.3C5.9 3.3 6.5 3 7 3h10c.6 0 1.1.3 1.5.7z"/></svg>
                <span>{{ rarity_value | capitalize }}</span>
                <span class="collection-filters__count">({{ rarity_counts[forloop.index0] }})</span>
                <span class="collection-filters__fake-checkbox" aria-hidden="true"></span>
              </a>
            {%- endunless -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
      <noscript><button type="submit" class="btn btn--primary btn--full">{{ 'collections.filters.apply' | t: default: 'Apply' }}</button></noscript>
      </form>
    </aside>

    <div class="collection-page__main">

      <div class="collection-page__controls">
        <div class="collection-tabs" role="tablist">
          <a href="{{ collection.url }}" class="pill-tab {% unless category_filter.active_values.size > 0 %}is-active{% endunless %}">
            {{ 'collections.tabs.all_items' | t: default: 'All items' }}
            <span class="collection-tabs__count">{{ collection.products_count }}</span>
          </a>
          {%- if category_filter -%}
            {%- for value in category_filter.values -%}
              {%- liquid
                assign static_count = value.count
                for t in category_tags
                  assign t_stripped = t | remove_first: 'category:'
                  if t == value.value or t_stripped == value.value
                    assign static_count = category_counts[forloop.index0]
                  endif
                endfor
              -%}
              <a href="{{ value.url_to_add }}" class="pill-tab {% if value.active %}is-active{% endif %}">
                {% render 'category-icon', category: value.value %}
                {{ value.label | capitalize }}
                <span class="collection-tabs__count">{{ static_count }}</span>
              </a>
            {%- endfor -%}
          {%- else -%}
            {%- for tag in category_tags -%}
              {%- unless tag == blank -%}
                {%- liquid
                  assign cat_value = tag | remove_first: 'category:'
                  assign cat_label = cat_value | replace: '-', ' ' | capitalize
                  assign cat_active = false
                  if current_tags contains tag
                    assign cat_active = true
                  endif
                  assign tag_handle = tag | handleize
                  assign tag_url = collection.url | append: '/' | append: tag_handle
                -%}
                <a href="{{ tag_url }}" class="pill-tab {% if cat_active %}is-active{% endif %}">
                  {% render 'category-icon', category: cat_value %}
                  {{ cat_label }}
                  <span class="collection-tabs__count">{{ category_counts[forloop.index0] }}</span>
                </a>
              {%- endunless -%}
            {%- endfor -%}
          {%- endif -%}
        </div>

        <div class="collection-page__toolbar">
          <form role="search" class="collection-page__search">
            <input type="search" name="q" placeholder="{{ 'collections.search.placeholder' | t: default: 'Search items' }}">
          </form>

          <select name="sort_by" class="collection-page__sort" data-sort-select>
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>{{ option.name }}</option>
            {%- endfor -%}
          </select>
        </div>
      </div>

      {%- if collection.metafields.custom.stock_warning != blank -%}
        <div class="alert--warning collection-page__banner">
          {{ collection.metafields.custom.stock_warning }}
        </div>
      {%- endif -%}

      {%- assign showing_all = true -%}
      {%- if category_filter.active_values.size > 0 -%}{%- assign showing_all = false -%}{%- endif -%}
      {%- if current_tags.size > 0 -%}{%- assign showing_all = false -%}{%- endif -%}

      {%- assign sections_rendered = 0 -%}

      {%- comment -%}
        Adopt Me has 126+ products across only two tags (Pets/Potions), so the
        sectioned "6 per category with a View all link" preview used by every
        other collection would hide almost the whole catalog. It gets the flat,
        progressively-loaded grid below instead — no other collection's layout
        changes.
      {%- endcomment -%}
      {%- assign is_adopt_me = false -%}
      {%- if collection.handle == 'adopt-me' -%}{%- assign is_adopt_me = true -%}{%- endif -%}

      {%- if showing_all and category_filter and is_adopt_me == false -%}
        {%- comment -%}
          "All items" view: sectioned category previews (matches bloxcart.com's
          own layout — see docs/catalog-audit.md) instead of one flat grid.
          Filtering by tag needs a wide-enough working set to find each
          category's items, hence paginating by 250 (Shopify's max) rather than the
          usual 24 — nothing here renders 250 cards, each section is capped
          to `section.settings.products_per_category`.
        {%- endcomment -%}
        {%- paginate collection.products by 250 -%}
          {%- for cat in category_filter.values -%}
            {%- comment -%}
              cat.value (Shopify's native filter value) is not guaranteed to
              be the literal product tag -- for a colon-style tag filter
              (category:guns) it's typically just the stripped value
              (guns), same ambiguity the tab-bar count logic above already
              hedges against. Resolve the real tag first via that same
              hedge.

              Matching itself is a manual for/if loop, NOT where_exp --
              see the comment above the count computation near the top of
              this file: where_exp/where were already found to behave
              inconsistently on this store for exactly this kind of tag
              match (it was returning the same near-unfiltered set for
              every category here, which is what put knives in the Guns
              section). The plain for/if loop is the same technique this
              file already trusts for counts.
            {%- endcomment -%}
            {%- liquid
              assign cat_tag = ''
              for tag in category_tags
                assign tag_stripped = tag | remove_first: 'category:'
                if tag == cat.value or tag_stripped == cat.value
                  assign cat_tag = tag
                endif
              endfor

              assign cat_product_count = 0
              for product in collection.products
                if product.tags contains cat_tag
                  assign cat_product_count = cat_product_count | plus: 1
                endif
              endfor
            -%}
            {%- if cat_product_count > 0 -%}
              {%- assign sections_rendered = sections_rendered | plus: 1 -%}
              <div class="collection-section">
                <div class="collection-section__header">
                  <span class="collection-section__icon">{% render 'category-icon', category: cat.value %}</span>
                  <h2>{{ cat.label | capitalize }}</h2>
                  <span class="collection-section__count">{{ cat.count }}</span>
                  <a href="{{ cat.url_to_add }}" class="collection-section__view-all">{{ 'collections.general.view_all' | t: default: 'View all' }}</a>
                </div>
                <div class="product-grid">
                  {%- liquid assign cards_rendered = 0 -%}
                  {%- for product in collection.products -%}
                    {%- if product.tags contains cat_tag -%}
                      {% render 'product-card', product: product %}
                      {%- assign cards_rendered = cards_rendered | plus: 1 -%}
                      {%- if cards_rendered >= section.settings.products_per_category -%}{%- break -%}{%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endpaginate -%}
      {%- elsif showing_all and category_tags.size > 0 and is_adopt_me == false -%}
        {%- comment -%}
          Same sectioned "all items" view as above, built from the plain
          category:{slug} tag fallback when Search & Discovery isn't
          configured for this collection.
        {%- endcomment -%}
        {%- paginate collection.products by 250 -%}
          {%- for tag in category_tags -%}
            {%- unless tag == blank -%}
              {%- comment -%}
                Manual for/if match, not where_exp -- see the comment on
                the native-filter branch above for why.
              {%- endcomment -%}
              {%- liquid
                assign cat_value = tag | remove_first: 'category:'
                assign cat_label = cat_value | replace: '-', ' ' | capitalize

                assign cat_product_count = 0
                for product in collection.products
                  if product.tags contains tag
                    assign cat_product_count = cat_product_count | plus: 1
                  endif
                endfor
              -%}
              {%- if cat_product_count > 0 -%}
                {%- assign sections_rendered = sections_rendered | plus: 1 -%}
                <div class="collection-section">
                  <div class="collection-section__header">
                    <span class="collection-section__icon">{% render 'category-icon', category: cat_value %}</span>
                    <h2>{{ cat_label }}</h2>
                    <span class="collection-section__count">{{ cat_product_count }}</span>
                    <a href="{{ collection.url }}/{{ tag | handleize }}" class="collection-section__view-all">{{ 'collections.general.view_all' | t: default: 'View all' }}</a>
                  </div>
                  <div class="product-grid">
                    {%- liquid assign cards_rendered = 0 -%}
                    {%- for product in collection.products -%}
                      {%- if product.tags contains tag -%}
                        {% render 'product-card', product: product %}
                        {%- assign cards_rendered = cards_rendered | plus: 1 -%}
                        {%- if cards_rendered >= section.settings.products_per_category -%}{%- break -%}{%- endif -%}
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endunless -%}
          {%- endfor -%}
        {%- endpaginate -%}
      {%- endif -%}

      {%- comment -%}
        Safety net: if "All items" was selected but the sectioned view above
        produced zero sections (stale/misconfigured category tags, no
        category data at all, etc.), never leave the page showing nothing --
        fall back to the plain unfiltered grid so every product is still
        visible and usable.
      {%- endcomment -%}
      {%- if showing_all and sections_rendered == 0 and is_adopt_me == false -%}
        {%- paginate collection.products by 24 -%}
          <div class="product-grid">
            {%- for product in collection.products -%}
              {% render 'product-card', product: product %}
            {%- else -%}
              <p class="collection-page__empty">{{ 'collections.general.no_matches' | t: default: 'No products match these filters.' }}</p>
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            <nav class="collection-page__pagination">
              {{ paginate | default_pagination }}
            </nav>
          {%- endif -%}
        {%- endpaginate -%}
      {%- elsif showing_all == false or is_adopt_me -%}
        {%- paginate collection.products by 24 -%}
          <div class="product-grid"
            {%- if is_adopt_me %} id="ProductGrid" data-infinite-grid
              data-next-page="{{ paginate.current_page | plus: 1 }}"
              data-total-pages="{{ paginate.pages }}"
              data-total-count="{{ collection.products_count }}"
              data-loaded-count="{{ collection.products.size }}"{% endif -%}>
            {%- for product in collection.products -%}
              {% render 'product-card', product: product %}
            {%- else -%}
              <p class="collection-page__empty">{{ 'collections.general.no_matches' | t: default: 'No products match these filters.' }}</p>
            {%- endfor -%}
          </div>

          {%- if is_adopt_me -%}
            {%- if paginate.pages > 1 -%}
              <div class="collection-page__load-more" data-load-more-wrap>
                <p class="collection-page__progress" data-load-progress>
                  Showing {{ collection.products.size }} of {{ collection.products_count }} items
                </p>
                <button type="button" class="btn--load-more" data-load-more-btn>
                  <span>{{ 'collections.general.show_more' | t: default: 'Show More Items' }}</span>
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <div class="collection-page__load-sentinel" data-load-sentinel aria-hidden="true"></div>
              </div>
            {%- else -%}
              <p class="collection-page__progress">
                Showing {{ collection.products.size }} of {{ collection.products_count }} items
              </p>
            {%- endif -%}
          {%- elsif paginate.pages > 1 -%}
            <nav class="collection-page__pagination">
              {{ paginate | default_pagination }}
            </nav>
          {%- endif -%}
        {%- endpaginate -%}
      {%- endif -%}

    </div>
  </div>
</div>

{%- if is_adopt_me -%}
  <script src="{{ 'collection-infinite.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Collection page",
  "settings": [
    {
      "type": "range",
      "id": "products_per_category",
      "label": "Products shown per category section (on \"All items\")",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6
    }
  ]
}
{% endschema %}
