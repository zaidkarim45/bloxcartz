{%- endcomment -%}
<div class="static-page page-width static-page--narrow">
  <h1>{{ section.settings.heading }}</h1>
  <p class="static-page__intro">{{ section.settings.intro }}</p>

  <form class="claim-form" data-claim-form action="#" method="get">
    <label>
      <span>{{ 'claim.order_reference' | t: default: 'Order number or reference' }}</span>
      <input type="text" name="order_reference" required>
    </label>
    <label>
      <span>{{ 'claim.email' | t: default: 'Checkout email' }}</span>
      <input type="email" name="email" required>
    </label>
    <button type="submit" class="btn btn--primary btn--full">{{ section.settings.cta_label }}</button>
  </form>

  <p class="static-page__note">{{ section.settings.note }}</p>
</div>

{% schema %}
{
  "name": "Claim order",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Claim your items" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Enter your order number and checkout email to claim your items." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Continue to claim" },
    { "type": "textarea", "id": "note", "label": "Footnote", "default": "Your details are checked securely and are never stored in the browser." }
  ],
  "presets": [{ "name": "Claim order" }]
}
{% endschema %}
