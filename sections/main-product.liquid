{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign rarity_tag = ''
  assign bestseller = false
  for tag in product.tags
    if tag contains 'rarity:'
      assign rarity_tag = tag | remove: 'rarity:'
    endif
    if tag == 'bestseller'
      assign bestseller = true
    endif
  endfor
  assign discount_pct = 0
  if variant.compare_at_price > variant.price
    assign discount_pct = variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price
  endif

  # `product.collections.first` isn't reliable for the breadcrumb/back-link --
  # it can resolve to an unrelated internal grouping collection (e.g. a
  # "Home page" featured-products collection) rather than the actual game,
  # depending on collection sort order. Find the real game collection
  # explicitly instead.
  assign game_handles = 'murder-mystery-2,steal-a-brainrot,blox-fruits,adopt-me,pet-simulator-99,blade-ball,grow-a-garden-2,99-nights-in-the-forest,dress-to-impress' | split: ','
  assign game_collection = null
  for c in product.collections
    if game_handles contains c.handle
      assign game_collection = c
    endif
  endfor
  if game_collection == null
    assign game_collection = product.collections.first
  endif
-%}

<div class="product-page page-width">

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="{{ game_collection.url | default: '/' }}" class="breadcrumb__back" aria-label="{{ 'general.breadcrumb.back' | t: default: 'Back' }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
    </a>
    {%- if game_collection -%}
      <a href="{{ game_collection.url }}">{{ game_collection.title }}</a>
      <span aria-hidden="true">›</span>
    {%- endif -%}
    {%- assign category_crumb = '' -%}
    {%- for tag in product.tags -%}
      {%- if tag contains 'category:' -%}
        {%- assign category_crumb = tag | remove_first: 'category:' | replace: '-', ' ' | capitalize -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if category_crumb != blank -%}
      <span>{{ category_crumb }}</span>
      <span aria-hidden="true">›</span>
    {%- endif -%}
    <span aria-current="page">{{ product.title }}</span>
  </nav>

  <div class="product-page__layout">

    <div class="product-page__gallery">
      {%- if product.featured_image -%}
        {{ product.featured_image | image_url: width: 800 | image_tag: alt: product.featured_image.alt, loading: 'eager' }}
      {%- endif -%}
    </div>

    <div class="product-page__info">
      <div class="product-page__badges">
        {%- if rarity_tag != blank -%}
          <span class="badge badge--rarity" style="--rarity-color: {% render 'rarity-color', rarity: rarity_tag %};">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.5 3.7l2.9 3.3c.7.8.7 1.9.1 2.7L13.7 20.2c-.9 1.1-2.6 1.1-3.4 0L2.4 9.8c-.6-.8-.6-2 .1-2.7l2.9-3.3C5.9 3.3 6.5 3 7 3h10c.6 0 1.1.3 1.5.7z"/></svg>
            {{ rarity_tag | capitalize }}
          </span>
        {%- endif -%}
        {%- if bestseller -%}
          <span class="badge badge--bestseller">🔥 {{ 'products.product.bestseller' | t: default: 'Bestseller' }}</span>
        {%- endif -%}
      </div>

      <h1 class="product-page__title">{{ product.title }}</h1>

      <div class="price price--large">
        <span class="price__current">{{ variant.price | money }}</span>
        {%- if variant.compare_at_price > variant.price -%}
          <span class="price__compare">
            <span class="price__compare-line"><span></span></span>
            {{ variant.compare_at_price | money }}
          </span>
          <span class="badge badge--discount">-{{ discount_pct }}% OFF</span>
        {%- endif -%}
      </div>

      {%- if product.description != blank -%}
        <div class="product-page__description">{{ product.description }}</div>
      {%- endif -%}

      {%- if rarity_tag != blank -%}
        <p class="product-page__rarity-line">{{ 'products.product.rarity' | t: default: 'Rarity' }}: {{ rarity_tag }}</p>
      {%- endif -%}

      <p class="product-page__stock {% if variant.available %}is-in-stock{% else %}is-out-of-stock{% endif %}">
        {%- if variant.available -%}
          {{ 'products.product.in_stock' | t: default: 'In stock' }}
        {%- else -%}
          {{ 'products.product.sold_out' | t: default: 'Out of stock' }}
        {%- endif -%}
      </p>

      {%- if variant.available -%}
        {%- comment -%}
          The live site's green glowing "Buy it now" next to "Add to cart"
          (confirmed Phase 0, not in the original spec) is almost certainly
          Shopify's native dynamic checkout / accelerated-checkout button —
          it only exists on Shopify-backed carts (Shop Pay, Apple Pay,
          Google Pay), which lines up with the Shopify Plus finding. Using
          the real `payment_button` here instead of a hand-rolled second
          button gets Shop Pay/Apple Pay/Google Pay for free and will
          render the same accent-colored glow Shopify themes ship by default.
        {%- endcomment -%}
        <div class="product-page__purchase-row">
          <form data-add-to-cart-form class="product-page__purchase-form">
            <input type="hidden" name="id" value="{{ variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <button type="submit" class="btn btn--primary product-page__add">
              {% render 'icon-cart' %} {{ 'products.product.add_to_cart' | t: default: 'Add to cart' }}
            </button>
          </form>
          {%- form 'product', product, class: 'product-page__buy-now-form' -%}
            <input type="hidden" name="id" value="{{ variant.id }}">
            {{ form | payment_button }}
          {%- endform -%}
        </div>
      {%- else -%}
        <button type="button" class="btn btn--disabled btn--full" disabled>
          {{ 'products.product.sold_out' | t: default: 'Out of stock' }}
        </button>
      {%- endif -%}

      {%- if shop.enabled_payment_types.size > 0 -%}
        <div class="product-page__payment-box">
          <div class="product-page__payment-icons">
            {%- for type in shop.enabled_payment_types -%}
              {{ type | payment_type_svg_tag: class: 'site-footer__payment-icon' }}
            {%- endfor -%}
          </div>
          <p class="product-page__secure-note">
            {{ 'products.product.secure_checkout' | t: default: 'Secure checkout with 256-bit encryption' }}
          </p>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if game_collection.products.size > 1 -%}
    <div class="product-page__similar">
      <h2>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2.5 20 5.5v6c0 5-3.4 8.7-8 10-4.6-1.3-8-5-8-10v-6l8-3Z"/></svg>
        {{ 'products.product.similar_items' | t: default: 'Similar items' }}
      </h2>
      <div class="product-grid">
        {%- assign similar_count = 0 -%}
        {%- for similar in game_collection.products -%}
          {%- if similar.id != product.id and similar_count < 6 -%}
            {% render 'product-card', product: similar %}
            {%- assign similar_count = similar_count | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

</div>

{% schema %}
{
  "name": "Product page",
  "settings": []
}
{% endschema %}
