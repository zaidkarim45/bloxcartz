  {
    "name": "Typography",
    "settings": [
      {
        "type": "paragraph",
        "content": "BloxCart's live site self-hosts Geist, Poppins, Plus Jakarta Sans and Outfit — none are in Shopify's curated font picker. These are bundled as theme assets and applied via CSS custom properties rather than Shopify's font_picker, so they render pixel-identical instead of falling back to a licensed substitute."
      },
      {
        "type": "select",
        "id": "font_heading_role",
        "label": "Heading font (see assets/fonts.css)",
        "options": [
          { "value": "geist", "label": "Geist" },
          { "value": "plus-jakarta-sans", "label": "Plus Jakarta Sans" }
        ],
        "default": "geist"
      },
      {
        "type": "select",
        "id": "font_body_role",
        "label": "Body font (see assets/fonts.css)",
        "options": [
          { "value": "geist", "label": "Geist" },
          { "value": "poppins", "label": "Poppins" }
        ],
        "default": "geist"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Page width",
        "min": 1200,
        "max": 1600,
        "step": 50,
        "unit": "px",
        "default": 1400
